generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum STATE {
  PENDING
  APPROVED
  REJECTED
}

model Hospital {
  id                String   @id @default(uuid())

  // Basic Information
  officialName      String   @map("official_name")
  shortName         String?  @map("short_name")
  registrationNumber String  @unique @map("registration_number")
  dhaLicenseNumber  String   @unique @map("dha_license_number")

  hospitalType      String   @map("hospital_type")
  specializationFocus String? @map("specialization_focus")

  // Branch / chain relationship
  // If this hospital is a branch, parentHospitalId stores the parent hospital's ID.
  parentHospitalId  String?  @map("parent_hospital_id")
  // Optional branch code (human-readable)
  branchId          String?  @map("branch_id")
  // Parent hospital keeps an array of its branch hospital IDs
  branchIds         String[] @default([]) @map("branch_ids")

  // Location
  emirate           String
  area              String?
  fullAddress       String
  poBox             String?
  latitude          Float?
  longitude         Float?
  state             STATE?  @default(PENDING)
  // Contact
  landline          String?
  mobile            String
  officialEmail     String   @unique
  website           String?
  facebook          String?
  instagram         String?

  // Operations
  operations        String?

  // Services & Specializations
  servicesOffered        String[]
  specializationsAvailable String[]

  // Documents – public S3 URLs (stored for quick read)
  tradeLicenseDocument           String?  @map("trade_license_document")
  tradeLicenseDocumentKey        String?  @map("trade_license_document_key")

  dhaLicenseDocument             String?  @map("dha_license_document")
  dhaLicenseDocumentKey          String?  @map("dha_license_document_key")

  insuranceDocuments             String[] @map("insurance_documents")
  insuranceDocumentKeys          String[] @map("insurance_document_keys")

  establishmentCard              String?  @map("establishment_card")
  establishmentCardKey           String?  @map("establishment_card_key")

  accreditationCertificates      String[] @map("accreditation_certificates")
  accreditationCertificateKeys   String[] @map("accreditation_certificate_keys")

  // Branding & Customisation
  logoKey               String?  @map("logo_key")
  logoUrl               String?  @map("logo_url")
  bannerKey             String?  @map("banner_key")
  bannerUrl             String?  @map("banner_url")
  primaryColor          String?  @map("primary_color")
  secondaryColor        String?  @map("secondary_color")

  // Relations
  finance                        Finance?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hospitals")
}

model Finance {
  id                     String   @id @default(uuid())

  // Commission Structure
  platformCommission     Float    @map("platform_commission")
  hospitalShare          Float    @map("hospital_share")

  // Payout Settings
  payoutFrequency        String   @map("payout_frequency")
  paymentMethod          String   @map("payment_method")
  minPayoutThreshold     Float    @map("min_payout_threshold")

  // Bank Details
  bankName               String   @map("bank_name")
  accountNumber          String   @map("account_number")
  iban                   String
  swiftCode              String   @map("swift_code")
  accountHolderName      String   @map("account_holder_name")
  branchAddress          String?  @map("branch_address")

  hospitalId             String   @unique
  hospital               Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("finances")
}

model Banners {
  id          String   @id @default(uuid())
  icon        String
  serviceDesc String
  title       String
  description String
  portal      PORTAL
  hospitalId  String?  @map("hospital_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PORTAL {
  PATIENT
  DOCTOR
  GENERAL
}

// ─── Support Ticket System ────────────────────────────────────────────────────

enum TICKET_STATUS {
  open
  in_progress
  resolved
  closed
}

enum TICKET_PRIORITY {
  High
  Medium
  Low
}

enum TICKET_CATEGORY {
  Booking_Issue
  Payment_Problem
  Technical_Issue
  Doctor_Query
  Other
}

enum TICKET_ACTOR {
  USER
  ADMIN
  SYSTEM
}

model SupportTicket {
  id          String          @id @default(uuid())
  ticketCode  String          @unique @map("ticket_code") // e.g. TK-001

  // Creator info (stored at creation time for quick display)
  userId      String          @map("user_id")
  userRole    String          @map("user_role") // PATIENT | DOCTOR | HOSPITAL_ADMIN

  // Ticket fields
  category    TICKET_CATEGORY
  subject     String
  description String          @db.Text

  // Status / Priority managed by admin
  status      TICKET_STATUS   @default(open)
  priority    TICKET_PRIORITY @default(Medium)

  // Optional: which admin is assigned to resolve this
  assignedToId String?        @map("assigned_to_id")

  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  timeline    TicketTimeline[]

  @@map("support_tickets")
}

model TicketTimeline {
  id        String       @id @default(uuid())
  ticketId  String       @map("ticket_id")

  text      String       @db.Text
  actor     TICKET_ACTOR @default(USER) // who wrote this entry
  userId    String       @map("user_id")  // actual user id of the author

  // System-generated entries (e.g. "Status changed to In Progress")
  isSystem  Boolean      @default(false) @map("is_system")

  createdAt DateTime     @default(now()) @map("created_at")

  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_timelines")
}
