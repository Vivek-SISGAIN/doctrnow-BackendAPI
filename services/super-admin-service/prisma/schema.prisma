// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum STATE {
  PENDING
  APPROVED
  REJECTED
}

model Hospital {
  id                String   @id @default(uuid())

  // Basic Information
  officialName      String   @map("official_name")
  shortName         String?  @map("short_name")
  registrationNumber String  @unique @map("registration_number")
  dhaLicenseNumber  String   @unique @map("dha_license_number")

  hospitalType      String   @map("hospital_type")
  specializationFocus String? @map("specialization_focus")

  // Branch
  branchId          String?  @map("branch_id")

  // Location
  emirate           String
  area              String?
  fullAddress       String
  poBox             String?
  latitude          Float?
  longitude         Float?
  state             STATE?  @default(PENDING)
  // Contact
  landline          String?
  mobile            String
  officialEmail     String   @unique
  website           String?
  facebook          String?
  instagram         String?

  // Operations
  operations        String?

  // Services & Specializations
  servicesOffered        String[]
  specializationsAvailable String[]

  // Documents – public S3 URLs (stored for quick read)
  tradeLicenseDocument           String?  @map("trade_license_document")
  tradeLicenseDocumentKey        String?  @map("trade_license_document_key")

  dhaLicenseDocument             String?  @map("dha_license_document")
  dhaLicenseDocumentKey          String?  @map("dha_license_document_key")

  insuranceDocuments             String[] @map("insurance_documents")
  insuranceDocumentKeys          String[] @map("insurance_document_keys")

  establishmentCard              String?  @map("establishment_card")
  establishmentCardKey           String?  @map("establishment_card_key")

  accreditationCertificates      String[] @map("accreditation_certificates")
  accreditationCertificateKeys   String[] @map("accreditation_certificate_keys")

  // Relations
  finance                        Finance?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("hospitals")
}

model Finance {
  id                     String   @id @default(uuid())

  // Commission Structure
  platformCommission     Float    @map("platform_commission")
  hospitalShare          Float    @map("hospital_share")

  // Payout Settings
  payoutFrequency        String   @map("payout_frequency")
  paymentMethod          String   @map("payment_method")
  minPayoutThreshold     Float    @map("min_payout_threshold")

  // Bank Details
  bankName               String   @map("bank_name")
  accountNumber          String   @map("account_number")
  iban                   String
  swiftCode              String   @map("swift_code")
  accountHolderName      String   @map("account_holder_name")
  branchAddress          String?  @map("branch_address")

  hospitalId             String   @unique
  hospital               Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@map("finances")
}

model Banners {
  id          String   @id @default(uuid())
  icon        String
  serviceDesc String
  title       String
  description String
  portal      PORTAL
  hospitalId  String?  @map("hospital_id")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum PORTAL {
  PATIENT
  DOCTOR
  GENERAL
}