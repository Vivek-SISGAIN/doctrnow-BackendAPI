{
  "name": "appointment-service",
  "version": "1.0.0",
  "description": "Appointment and scheduling service for DoctorNow",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "lint:check": "eslint src/**/*.js --max-warnings 0",
    "format": "prettier --write \"**/*.{js,json,md,prisma}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,prisma}\"",
    "format:src": "prettier --write \"src/**/*.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:reset": "prisma migrate reset",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "prisma:format": "prisma format",
    "seed": "node src/seed.js",
    "seed:check": "node -e \"require('./src/seed.js')\"",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate",
    "db:seed": "npm run seed",
    "build": "rimraf dist && mkdir dist && copyfiles -u 1 src/**/* dist",
    "start:prod": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "axios": "^1.13.6",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dayjs": "^1.11.20",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.0.2",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.3",
    "nodemon": "^3.1.11",
    "prettier": "^3.2.5",
    "prisma": "^6.19.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3"
  }
}
