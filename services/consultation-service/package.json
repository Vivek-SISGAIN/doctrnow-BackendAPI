{
  "name": "consultation-service",
  "version": "1.0.0",
  "description": "Consultation notes, history, and session management service for DoctorNow",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "lint:check": "eslint src/**/*.js --max-warnings 0",
    "format": "prettier --write \"**/*.{js,json,md,prisma}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,prisma}\"",
    "format:src": "prettier --write \"src/**/*.js\"",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev",
    "prisma:migrate:deploy": "npx prisma migrate deploy",
    "prisma:migrate:reset": "npx prisma migrate reset",
    "prisma:migrate:status": "npx prisma migrate status",
    "prisma:studio": "npx prisma studio",
    "prisma:format": "npx prisma format",
    "db:setup": "npm run prisma:generate && npm run prisma:migrate",
    "seed": "node src/seed.js",
    "db:seed": "npm run seed",
    "build": "rimraf dist && copyfiles -u 1 \"src/**/*\" dist",
    "start:prod": "node dist/server.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.15.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "express": "^4.22.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "prettier": "^3.2.5",
    "prisma": "^6.19.2",
    "redis": "^5.12.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "copyfiles": "^2.4.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.2.5",
    "rimraf": "^6.1.3"
  }
}
