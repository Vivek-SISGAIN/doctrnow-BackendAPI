generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Consultation {
  id                String            @id @default(uuid())
  appointmentId     String            @unique
  patientId         String
  doctorId         String
  hospitalId        String?
  status            ConsultationStatus @default(PENDING)
  startedAt         DateTime?
  endedAt           DateTime?
  duration          Int?              // Duration in seconds
  type              ConsultationType  @default(VIDEO)
  diagnosis         String?
  followUp          String?
  patientJoinedAt   DateTime?         // When patient joined the virtual lobby
  consentRequestedAt DateTime?       // When doctor requested consent
  consentAcceptedAt  DateTime?        // When patient accepted consent
  channelName       String?           // Agora channel for this consultation (e.g. appointment-{appointmentId}); both patient and doctor join this
  patientAuthId     String?
  doctorAuthId      String?
  rating            Int?              // 1-5, nullable until reviewed
  comment           String?           // optional review comment
  isAnonymous       Boolean           @default(false)
  reviewedAt        DateTime?         // null if not yet reviewed
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  notes             ConsultationNote[]
  vitals            ConsultationVitals?

  @@map("consultations")
  @@index([patientId])
  @@index([doctorId])
  @@index([hospitalId])
  @@index([appointmentId])
  @@index([status])
  @@index([startedAt])
}

model ConsultationNote {
  id                String       @id @default(uuid())
  consultationId    String
  content           String
  createdBy         String       // Doctor ID
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  consultation      Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_notes")
  @@index([consultationId])
  @@index([createdAt])
}

model ConsultationVitals {
  id                 String       @id @default(uuid())
  consultationId     String       @unique
  bloodPressure      String?      // e.g., "120/80"
  pulse              String?      // e.g., "72 bpm"
  temperature        String?      // e.g., "98.6°F"
  spo2               String?      // e.g., "98%"
  weight             String?      // e.g., "70 kg"
  height             String?      // e.g., "170 cm"
  notes              String?
  allergies          String[]     // e.g. ["Penicillin", "NSAIDs"]
  criticalConditions String[]     // e.g. ["Diabetes Type 2", "Hypertension"]
  medications        String[]     // e.g. ["Aspirin", "Metformin"]
  lifestyleHabits    String?      @db.Text
  recordedAt         DateTime     @default(now())

  consultation      Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)

  @@map("consultation_vitals")
  @@index([consultationId])
}

enum ConsultationStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ConsultationType {
  VIDEO
  AUDIO
  CHAT
}
