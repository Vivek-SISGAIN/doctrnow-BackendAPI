generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id            String         @id @default(uuid())
  userId        String         @unique
  mobileNumber  String         @unique
  profileImage  String
  email         String         @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  emiratesId    String         @unique
  nationality   String
  bloodGroup    BloodGroup?
  maritalStatus MaritalStatus?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  lastVisit DateTime?
  @@map("patient")
}

model FamilyMember {
  id                 String           @id @default(uuid())
  patientId          String
  relationshipType   RelationshipType
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  gender             Gender
  emiratesId         String?          @unique
  nationality        String
  mobileNumber       String?
  email              String?
  bloodGroup         BloodGroup?
  isEmergencyContact Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("family_member")
}

model Specialty {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  imageKey     String?  // e.g. "general-physician" for UI asset mapping
  bgColor      String?  // e.g. "bg-purple-100" for UI
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("specialty")
}

model Doctor {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  status                  DoctorStatus       @default(PENDING)
  availabilityStatus      AvailabilityStatus @default(OFFLINE)
  fullName                String
  email                   String       @unique
  mobile                  String
  gender                  Gender
  nationality             String
  emiratesId              String       @unique
  primarySpecialization   String
  subSpecialization       String?
  licenseNumber           String       @unique
  licenseType             LicenseType
  licenseExpiry           DateTime
  yearsOfExperience       Int
  medicalDegree           String
  university              String
  profileImage            String
  languagesSpoken         String[]
  servicesOffered         String[]
  certifications          String[]
  professionalMemberships String[]
  professionalBio         String
  schedule                Json
  consultationDuration    Int
  videoConsultationFee    Decimal      @db.Decimal(10, 2)
  phoneConsultationFee    Decimal      @db.Decimal(10, 2)
  followUpFee             Decimal      @db.Decimal(10, 2)
  hospitalSharePercent    Int
  platformSharePercent    Int
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@map("doctor")
}

model HospitalAdmin {
  id           String   @id @default(uuid())
  userId       String   @unique
  fullName     String
  email        String   @unique
  phoneNumber  String   @unique
  gender       Gender
  nationality  String
  emiratesId   String   @unique
  hospitalName String
  profileImage String
  hospitalId   String
  position     String
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("hospital_admin")
}

model SuperAdmin {
  id           String   @id @default(uuid())
  userId       String   @unique
  fullName     String
  email        String   @unique
  phoneNumber  String   @unique
  gender       Gender
  nationality  String
  emiratesId   String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profileImage String

  @@map("super_admin")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum RelationshipType {
  SPOUSE
  FATHER
  MOTHER
  SON
  DAUGHTER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDSON
  GRANDDAUGHTER
  OTHER
}

enum DoctorStatus {
  ACTIVE
  ON_LEAVE
  PENDING
  INACTIVE
}

enum AvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum LicenseType {
  DHA
  HAAD
}

enum WorkingDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model InsuranceProvider {
  id String @id @default(uuid())

  providerName String

  providerType ProviderType

  contactEmail String
  contactPhone String
  website      String?

  networkType NetworkType

  claimSubmissionMethod ClaimSubmissionMethod

  avgProcessingDays Int?

  address String

  supportedServices SupportedService[]

  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("insurance_provider")
}

enum ProviderType {
  INSURANCE_COMPANY
  TPA
}

enum NetworkType {
  IN_NETWORK
  OUT_NETWORK
  BOTH
}

enum ClaimSubmissionMethod {
  ONLINE_PORTAL
  EMAIL
  MANUAL
  API
}

enum SupportedService {
  CONSULTATION
  LAB_TESTS
  PACKAGES
  DIAGNOSTICS
  HOME_CARE
  SURGERY
  EMERGENCY
}
