// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id     String @id @default(uuid())
  userId String @unique

  mobileNumber String   @unique
  profileImage String
  email        String   @unique
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  emiratesId   String   @unique
  nationality  String

  bloodGroup    BloodGroup?
  maritalStatus MaritalStatus?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patient")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

model FamilyMember {
  id String @id @default(uuid())

  patientId        String
  relationshipType RelationshipType

  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  emiratesId   String?  @unique
  nationality  String
  mobileNumber String?
  email        String?

  bloodGroup BloodGroup?

  isEmergencyContact Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("family_member")
}

enum RelationshipType {
  SPOUSE
  FATHER
  MOTHER
  SON
  DAUGHTER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDSON
  GRANDDAUGHTER
  OTHER
}

model Doctor {
  id     String @id @default(uuid())
  userId String @unique

  fullName    String
  email       String @unique
  phoneNumber String @unique
  gender      Gender
  nationality String
  emiratesId  String @unique

  primarySpecialization String
  subSpecialization     String?
  licenseNumber         String      @unique
  licenseType           LicenseType
  licenseExpiry         DateTime
  yearsOfExperience     Int
  medicalDegree         String
  university            String
  profileImage          String

  languagesSpoken         String[]
  servicesOffered         String[]
  certifications          String[]
  professionalMemberships String[]

  professionalBio String

  workingDays          WorkingDay[]
  workingHoursFrom     String
  workingHoursTo       String
  consultationDuration Int

  videoConsultationFee Decimal @db.Decimal(10, 2)
  phoneConsultationFee Decimal @db.Decimal(10, 2)
  followUpFee          Decimal @db.Decimal(10, 2)

  hospitalSharePercent Int
  platformSharePercent Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("doctor")
}

enum LicenseType {
  FULL_LICENSE
  TEMPORARY_LICENSE
  SPECIALIST_LICENSE
  CONSULTANT_LICENSE
}

enum WorkingDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

model HospitalAdmin {
  id     String @id @default(uuid())
  userId String @unique

  fullName    String
  email       String @unique

  phoneNumber String @unique
  gender      Gender
  nationality String
  emiratesId  String @unique

  hospitalName String
  profileImage String
  hospitalId   String
  position     String
  department   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("hospital_admin")
}

model SuperAdmin {
  id     String @id @default(uuid())
  userId String @unique

  fullName    String
  email       String   @unique
  phoneNumber String   @unique
  gender      Gender
  nationality String
  emiratesId  String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  profileImage String

  @@map("super_admin")
}