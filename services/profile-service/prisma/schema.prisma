generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Patient {
  id            String                @id @default(uuid())
  userId        String                @unique
  mobileNumber  String                @unique
  profileImage  String
  status        String       @default("ACTIVE")
  email         String                @unique
  firstName     String
  lastName      String
  dateOfBirth   DateTime
  gender        Gender
  emiratesId    String                @unique
  nationality   String
  bloodGroup    BloodGroup?
  maritalStatus MaritalStatus?
  mrn           String?               @unique
  insuranceId   String?
  riskCategory  RiskCategory?         @default(LOW)
  patientType   PatientType?          @default(ACUTE)
  followUpStatus FollowUpStatus?      @default(NO_FOLLOWUP)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  lastVisit     DateTime?
  totalVisits   Int                   @default(0)
  healthProfile PatientHealthProfile?

  @@map("patient")
}

model PatientHealthProfile {
  id              String   @id @default(uuid())
  patientId       String   @unique
  weight          String?
  height          String?
  bloodPressure   String?
  sugarLevel      String?
  temperature     String?
  pulse           String?
  spo2            String?
  allergies       String[]
  conditions      String[]
  medications     String[]
  lifestyleHabits String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  patient         Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@map("patient_health_profile")
}

model FamilyMember {
  id                 String           @id @default(uuid())
  patientId          String
  relationshipType   RelationshipType
  firstName          String
  lastName           String
  dateOfBirth        DateTime
  gender             Gender
  emiratesId         String?          @unique
  nationality        String
  mobileNumber       String?
  email              String?
  bloodGroup         BloodGroup?
  isEmergencyContact Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@map("family_member")
}

model Specialty {
  id           String   @id @default(uuid())
  name         String   @unique
  slug         String   @unique
  imageKey     String?
  bgColor      String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("specialty")
}

model Doctor {
  id                      String             @id @default(uuid())
  userId                  String             @unique
  status                  DoctorStatus       @default(PENDING)
  availabilityStatus      AvailabilityStatus @default(OFFLINE)
  fullName                String
  email                   String             @unique
  mobile                  String
  gender                  Gender
  nationality             String
  emiratesId              String             @unique
  primarySpecialization   String
  hospitalId              String
  subSpecialization       String?
  licenseNumber           String             @unique
  licenseType             LicenseType
  licenseExpiry           DateTime
  yearsOfExperience       Int
  medicalDegree           String
  university              String
  countryOfEducation      String?
  educationDetails        Json?
  experienceDetails       Json?
  profileImage            String
  languagesSpoken         String[]
  servicesOffered         String[]
  certifications          String[]
  professionalMemberships String[]
  professionalBio         String
  schedule                Json
  videoConsultationFee    Decimal            @db.Decimal(10, 2)
  phoneConsultationFee    Decimal            @db.Decimal(10, 2)
  followUpFee             Decimal            @db.Decimal(10, 2)
  hospitalSharePercent    Int
  platformSharePercent    Int
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt
  assignedHospitalIds     String[]           @default([])

  // ── Documents — S3 keys (null until uploaded) ─────────────────────────────
  docMedicalLicenseKey          String?
  docMedicalLicenseStatus       DocumentStatus @default(PENDING)
  docMedicalLicenseFileName     String?
  docMedicalLicenseMime         String?

  docEmiratesIdKey              String?
  docEmiratesIdStatus           DocumentStatus @default(PENDING)
  docEmiratesIdFileName         String?
  docEmiratesIdMime             String?

  docPassportKey                String?
  docPassportStatus             DocumentStatus @default(PENDING)
  docPassportFileName           String?
  docPassportMime               String?

  docProfessionalPhotoKey       String?
  docProfessionalPhotoStatus    DocumentStatus @default(PENDING)
  docProfessionalPhotoFileName  String?
  docProfessionalPhotoMime      String?

  docMedicalDegreeKey           String?
  docMedicalDegreeStatus        DocumentStatus @default(PENDING)
  docMedicalDegreeFileName      String?
  docMedicalDegreeMime          String?

  docSpecialistCertKey          String?
  docSpecialistCertStatus       DocumentStatus @default(PENDING)
  docSpecialistCertFileName     String?
  docSpecialistCertMime         String?

  docCvResumeKey                String?
  docCvResumeStatus             DocumentStatus @default(PENDING)
  docCvResumeFileName           String?
  docCvResumeMime               String?

  docGoodStandingKey            String?
  docGoodStandingStatus         DocumentStatus @default(PENDING)
  docGoodStandingFileName       String?
  docGoodStandingMime           String?

  @@map("doctor")
}

enum DocumentStatus {
  PENDING
  UPLOADED
  VERIFIED
  REJECTED
}

enum HospitalAdminSubRole {
  ADMIN
  MASTER_ADMIN
}

model HospitalAdmin {
  id           String   @id @default(uuid())
  userId       String   @unique
  fullName     String
  email        String   @unique
  phoneNumber  String   @unique
  gender       Gender
  nationality  String
  emiratesId   String   @unique
  hospitalName String
  profileImage String
  hospitalId   String   @default(cuid())
  position     String
  department   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  subRole      HospitalAdminSubRole? @default(MASTER_ADMIN)
  permissions  String[]              @default([])

  @@map("hospital_admin")
}

model SuperAdmin {
  id           String   @id @default(uuid())
  userId       String   @unique
  fullName     String
  email        String   @unique
  phoneNumber  String   @unique
  gender       Gender
  nationality  String
  emiratesId   String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profileImage String

  @@map("super_admin")
}

model InsuranceProvider {
  id                    String                @id @default(uuid())
  providerName          String
  providerType          ProviderType
  contactEmail          String
  contactPhone          String
  website               String?
  networkType           NetworkType
  claimSubmissionMethod ClaimSubmissionMethod
  avgProcessingDays     Int?
  address               String
  supportedServices     SupportedService[]
  note                  String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("insurance_provider")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

enum RelationshipType {
  SPOUSE
  FATHER
  MOTHER
  SON
  DAUGHTER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDSON
  GRANDDAUGHTER
  OTHER
}

enum DoctorStatus {
  ACTIVE
  ON_LEAVE
  PENDING
  INACTIVE
}

enum AvailabilityStatus {
  ONLINE
  OFFLINE
  BUSY
}

enum LicenseType {
  DHA
  HAAD
}

enum WorkingDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum ProviderType {
  INSURANCE_COMPANY
  TPA
}

enum NetworkType {
  IN_NETWORK
  OUT_NETWORK
  BOTH
}

enum ClaimSubmissionMethod {
  ONLINE_PORTAL
  EMAIL
  MANUAL
  API
}

enum SupportedService {
  CONSULTATION
  LAB_TESTS
  PACKAGES
  DIAGNOSTICS
  HOME_CARE
  SURGERY
  EMERGENCY
}

enum RiskCategory {
  HIGH
  MEDIUM
  LOW
}

enum PatientType {
  CHRONIC
  ACUTE
}

enum FollowUpStatus {
  SCHEDULED
  OVERDUE
  NO_FOLLOWUP
}
