# ============================================
# Authentication & Identity Service - Environment Configuration
# ============================================
# Copy this file to .env and update with your values
# DO NOT commit .env to version control

# ============================================
# SERVER CONFIGURATION
# ============================================

# Node environment (development, staging, production)
NODE_ENV=development

# Server port
PORT=3001

# Trust proxy (set to true when behind reverse proxy/load balancer)
TRUST_PROXY=true

# ============================================
# DATABASE CONFIGURATION
# ============================================

# PostgreSQL connection string
DATABASE_URL=postgresql://doctornow:changeme@localhost:5432/auth_db

# ============================================
# JWT CONFIGURATION
# ============================================

# JWT Issuer (must match API Gateway configuration)
JWT_ISSUER=doctornow-platform

# JWT Audience (must match API Gateway configuration)
JWT_AUDIENCE=doctornow-api

# Access token TTL (seconds) - Default: 15 minutes
JWT_ACCESS_TOKEN_TTL=900

# Refresh token TTL (seconds) - Default: 7 days
JWT_REFRESH_TOKEN_TTL=604800

# ============================================
# PASSWORD SECURITY
# ============================================

# Password hashing algorithm (bcrypt or argon2)
PASSWORD_HASH_ALGORITHM=bcrypt

# Bcrypt rounds (if using bcrypt)
PASSWORD_HASH_ROUNDS=12

# Password policy
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=false

# ============================================
# ACCOUNT LOCKOUT
# ============================================

# Maximum failed login attempts before lockout
MAX_LOGIN_ATTEMPTS=5

# Lockout duration (minutes)
LOCKOUT_DURATION_MINUTES=30

# ============================================
# OTP CONFIGURATION
# ============================================

# OTP length (digits)
OTP_LENGTH=6

# OTP TTL (seconds) - Default: 5 minutes
OTP_TTL_SECONDS=300

# Maximum OTP verification attempts
OTP_MAX_ATTEMPTS=3

# ============================================
# RATE LIMITING
# ============================================

# Rate limit time window (milliseconds)
RATE_LIMIT_TTL=900000

# Maximum requests per time window (global)
RATE_LIMIT_MAX=100

# Maximum login attempts per time window
RATE_LIMIT_LOGIN_MAX=5

# Maximum OTP requests per time window
RATE_LIMIT_OTP_MAX=3

# ============================================
# CORS CONFIGURATION
# ============================================

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Allow credentials
CORS_CREDENTIALS=true

# ============================================
# EVENT BUS (KAFKA)
# ============================================

# Set to true to enable Kafka (default: false in dev, true when NODE_ENV=production)
# When false, auth-service starts without connecting to Kafka; events are logged only.
# KAFKA_ENABLED=true

# Kafka brokers (comma-separated)
KAFKA_BROKERS=localhost:9092

# Kafka client ID
KAFKA_CLIENT_ID=auth-service

# Kafka consumer group ID
KAFKA_GROUP_ID=auth-service-group

# ============================================
# ENCRYPTION
# ============================================

# Encryption key for private key storage (REQUIRED in production)
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# ============================================
# LOGGING
# ============================================

# Log level (error, warn, info, debug, verbose)
LOG_LEVEL=info

# ============================================
# PRODUCTION NOTES
# ============================================
# For production deployment:
#
# 1. Set NODE_ENV=production
# 2. Use strong DATABASE_URL with password
# 3. Set ENCRYPTION_KEY (32+ character random string)
# 4. Configure Kafka brokers
# 5. Set appropriate CORS_ORIGINS
# 6. Use secrets manager for sensitive values
# 7. Enable account lockout and rate limiting
# 8. Use Argon2 for password hashing (more secure)

