// Prisma Schema for Authentication & Identity Service
// Database: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @map("tenant_id") @db.Uuid
  email               String   @unique @db.VarChar(255)
  mobile              String?  @db.VarChar(20)
  passwordHash        String   @map("password_hash") @db.Text
  role                UserRole
  status              UserStatus @default(ACTIVE)
  failedLoginAttempts Int      @map("failed_login_attempts") @default(0)
  lockedUntil         DateTime? @map("locked_until") @db.Timestamp
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamp

  sessions            Session[]
  otpRequests         OtpRequest[]
  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([mobile])
  @@index([status])
  @@index([tenantId])
  @@map("users")
}

model Session {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  refreshTokenHash String   @map("refresh_token_hash") @db.Text
  deviceId        String?  @map("device_id") @db.VarChar(255)
  ipAddress       String?  @map("ip_address") @db.VarChar(45)
  userAgent       String?  @map("user_agent") @db.Text
  expiresAt       DateTime @map("expires_at") @db.Timestamp
  revokedAt       DateTime? @map("revoked_at") @db.Timestamp
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamp

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
  @@index([tenantId])
  @@map("sessions")
}

model OtpRequest {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String?     @map("user_id") @db.Uuid
  tenantId      String?     @map("tenant_id") @db.Uuid
  otpHash       String      @map("otp_hash") @db.Text
  purpose       OtpPurpose
  expiresAt     DateTime    @map("expires_at") @db.Timestamp
  verified      Boolean     @default(false)
  attemptCount  Int         @map("attempt_count") @default(0)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamp
  identifierEmail String?   @map("identifier_email") @db.VarChar(255)
  identifierMobile String?  @map("identifier_mobile") @db.VarChar(20)

  user          User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([otpHash])
  @@index([expiresAt])
  @@index([tenantId])
  @@index([identifierMobile])
  @@index([identifierEmail])
  @@map("otp_requests")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.Text
  expiresAt DateTime @map("expires_at") @db.Timestamp
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model JwtKey {
  id         String   @id @default(uuid()) @db.Uuid
  keyId      String   @unique @map("key_id") @db.VarChar(255)
  publicKey  String   @map("public_key") @db.Text
  privateKey String   @map("private_key") @db.Text // Encrypted at rest
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp

  @@index([keyId])
  @@index([isActive])
  @@map("jwt_keys")
}

enum UserRole {
  PATIENT
  DOCTOR
  HOSPITAL_ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum OtpPurpose {
  LOGIN
  PASSWORD_RESET
  REGISTRATION
}

