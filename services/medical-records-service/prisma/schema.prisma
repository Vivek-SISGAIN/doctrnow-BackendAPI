generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Prescription {
  id             String                @id @default(uuid())
  appointmentId  String?
  consultationId String?
  patientId      String
  doctorId       String
  rxId           String                @unique // Format: RX-YYYY-MMDD-XXX
  diagnosis      String?
  lifecycle      PrescriptionLifecycle @default(DRAFT)
  signedAt       DateTime?
  sentAt         DateTime?
  viewedAt       DateTime?
  s3Key          String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  medications         PrescriptionMedication[]
  precautions         PrescriptionPrecaution[]
  dietRecommendations PrescriptionDiet[]

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([consultationId])
  @@index([lifecycle])
  @@index([rxId])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id             String   @id @default(uuid())
  prescriptionId String
  name           String
  strength       String
  dosage         String // e.g., "1", "1.5", "2"
  frequency      String // e.g., "Once daily", "Twice daily"
  duration       String // e.g., "30 days", "90 days"
  isControlled   Boolean  @default(false)
  type           String? // e.g., "Tablet", "Capsule", "Syrup"
  instructions   String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_medications")
}

model PrescriptionPrecaution {
  id             String   @id @default(uuid())
  prescriptionId String
  text           String
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_precautions")
}

model PrescriptionDiet {
  id             String   @id @default(uuid())
  prescriptionId String
  text           String
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_diet")
}

model MedicalDocument {
  id             String       @id @default(uuid())
  patientId      String
  doctorId       String?
  appointmentId  String?
  consultationId String?
  name           String
  type           DocumentType
  filePath       String
  fileSize       Int // in bytes
  mimeType       String?
  uploadedBy     String // User ID who uploaded
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([appointmentId])
  @@index([consultationId])
  @@index([type])
  @@map("medical_documents")
}

enum PrescriptionLifecycle {
  DRAFT
  SIGNED
  SENT
  VIEWED
}

enum DocumentType {
  LAB_REPORT
  RADIOLOGY
  PRESCRIPTION
  CONSULTATION_NOTES
  REFERRAL
  OTHER
}

// Lab reports - schema matches doctor portal UI (LabReportDetail + TestResult)
model LabReport {
  id               String            @id @default(uuid())
  patientId        String
  doctorId         String
  appointmentId    String?
  consultationId   String?
  reportId         String            @unique // e.g. LAB-2024-001234-001
  consultationDate DateTime? // date of order/consultation
  consultationTime String? // e.g. "09:00 AM"
  orderedTests     String[] // test names ordered
  status           LabReportStatus   @default(PENDING)
  priority         LabReportPriority @default(ROUTINE)
  resultDate       DateTime?
  notes            String?
  results          Json? // array of { name, value, unit, referenceRange, flag, previousValue?, previousDate? }
  isReviewed       Boolean           @default(false)
  reviewedAt       DateTime?
  reviewComments   String?
  sentToPatient    Boolean           @default(false)
  sentAt           DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([patientId])
  @@index([doctorId])
  @@index([status])
  @@index([createdAt])
  @@map("lab_reports")
}

enum LabReportStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SENT
}

enum LabReportPriority {
  ROUTINE
  URGENT
  STAT
}
