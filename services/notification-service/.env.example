DATABASE_URL=postgresql://postgres:password@localhost:5432/notification-service
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Existing notification exchanges
RABBITMQ_RETRY_DELAY_MS=15000

# OTP event topology
OTP_EVENTS_EXCHANGE=auth_events_exchange
OTP_SENT_ROUTING_KEY=auth.otp.sent
OTP_SENT_QUEUE=auth.otp.sent.queue
OTP_SENT_RETRY_QUEUE=auth.otp.sent.retry.queue
OTP_MAX_RETRIES=3

SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=user
SMTP_EMAIL=email
SMTP_PASS=password

TWILIO_MOCK_MODE=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=token
TWILIO_FROM_NUMBER=+12345678
