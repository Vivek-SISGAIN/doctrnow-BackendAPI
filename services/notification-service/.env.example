DATABASE_URL=postgresql://postgres:password@localhost:5432/notification-service
RABBITMQ_URL=amqp://guest:guest@doctor-rabbitmq:5672

# Prefer routing inter-service HTTP calls through the API Gateway:
# Example: http://localhost:8080/api/v1
API_GATEWAY="http://localhost:8080/api/v1"

# When using API_GATEWAY in production, set this to match the gateway's INTERNAL_SERVICE_SECRET
# so JwtAuthGuard can bypass authentication for internal calls.
INTERNAL_SERVICE_SECRET=""

# Existing notification exchanges
RABBITMQ_RETRY_DELAY_MS=15000

# OTP event topology
OTP_EVENTS_EXCHANGE=auth_events_exchange
OTP_SENT_ROUTING_KEY=auth.otp.sent
OTP_SENT_QUEUE=auth.otp.sent.queue
OTP_SENT_RETRY_QUEUE=auth.otp.sent.retry.queue
OTP_MAX_RETRIES=3

SMTP_HOST=mail.smtp2go.com
SMTP_PORT=587
SMTP_USER=user
SMTP_EMAIL=email
SMTP_PASS=password

TWILIO_MOCK_MODE=true
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=token
TWILIO_FROM_NUMBER=+12345678
