generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Channel {
  EMAIL
  SMS
  PUSH
  IN_APP
}

enum Status {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum Platform {
  ANDROID
  IOS
  WEB
}

model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String
  channel    Channel
  status     Status   @default(PENDING)
  title      String
  body       String
  payload    Json?
  retryCount Int      @default(0)
  maxRetries Int      @default(3)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("notifications")
}

model UserDevice {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String
  fcmToken  String   @unique
  platform  Platform @default(WEB)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_devices")
}