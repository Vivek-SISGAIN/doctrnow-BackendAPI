# Server Configuration
PORT=3006
HOST=localhost
NODE_ENV=development

# Cerner FHIR R4 Sandbox Configuration
CERNER_FHIR_BASE_URL=https://fhir-open.cerner.com/r4/ec2458f2-1e24-41c8-b71b-0e701af7583d
DEFAULT_SANDBOX_PATIENT_ID=12742400
CERNER_TIMEOUT_MS=10000

# CORS & Gateway
CORS_ORIGIN=http://localhost:8080,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:1234
INTERNAL_SERVICE_SECRET=super_secret_internal_key_123

# Database (PostgreSQL — used by Prisma)
DATABASE_URL=postgresql://postgres:password@localhost:5432/payment_insurance_db

# ── Stripe Connect ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe redirects the hospital here if the onboarding link expires (refresh)
STRIPE_CONNECT_ONBOARDING_REFRESH_URL=http://localhost:3000/dashboard/stripe/refresh
# Stripe redirects here after the hospital finishes or skips onboarding
STRIPE_CONNECT_ONBOARDING_RETURN_URL=http://localhost:3000/dashboard/stripe/return

# ── Internal Service URLs ──────────────────────────────────────────────────────
# Base URL for calls from payment-insurance-service → super-admin-service
SUPER_ADMIN_SERVICE_URL=http://localhost:5001
PROFILE_SERVICE_URL=http://localhost:5000
APPOINTMENT_SERVICE_URL=http://localhost:3003

# Where Stripe Checkout redirects the patient after payment (placeholder until
# the patient-frontend integration in Phase 3 — update these then)
PATIENT_APP_CHECKOUT_SUCCESS_URL=http://localhost:3000/payment/confirmation?session_id={CHECKOUT_SESSION_ID}
PATIENT_APP_CHECKOUT_CANCEL_URL=http://localhost:3000/payment/options
