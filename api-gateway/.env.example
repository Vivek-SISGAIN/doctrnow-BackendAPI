# =============================================================================
# API GATEWAY – Local Development Environment
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
TRUST_PROXY=true

# -----------------------------------------------------------------------------
# JWT / AUTH
# -----------------------------------------------------------------------------
JWT_JWKS_URI=http://localhost:3001/auth/v1/.well-known/jwks.json
JWT_ISSUER=doctornow-platform
JWT_AUDIENCE=doctornow-api
JWT_ALGORITHM=RS256
SKIP_APPOINTMENT_AUTH=true

# -----------------------------------------------------------------------------
# REDIS
# -----------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_OPTIONAL=true

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_TTL=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_TTL=900000
RATE_LIMIT_AUTH_MAX=5

# -----------------------------------------------------------------------------
# CORS — all localhost origins your portals run on
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173,http://localhost:8081,http://localhost:1234
CORS_CREDENTIALS=true

# -----------------------------------------------------------------------------
# DOWNSTREAM SERVICE URLs
# -----------------------------------------------------------------------------
AUTH_SERVICE_URL=http://localhost:3001
PROFILE_SERVICE_URL=http://localhost:5000
APPOINTMENT_SERVICE_URL=http://localhost:3003
CONSULTATION_SERVICE_URL=http://localhost:3005
# Local dev: video-chat-service runs on 3007 by default (see services/video-chat-service/.env)
VIDEO_CHAT_SERVICE_URL=http://localhost:3007
PAYMENT_SERVICE_URL=http://localhost:3006
MEDICAL_RECORDS_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3008
HOSPITAL_ADMIN_SERVICE_URL=http://localhost:3009
SUPER_ADMIN_SERVICE_URL=http://localhost:3010
AUDIT_SERVICE_URL=http://localhost:3011

# -----------------------------------------------------------------------------
# CIRCUIT BREAKER — disabled locally so a down service doesn't block everything
# -----------------------------------------------------------------------------
CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_TIMEOUT=3000
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=30000

# -----------------------------------------------------------------------------
# HTTP CLIENT
# -----------------------------------------------------------------------------
HTTP_TIMEOUT=5000
HTTP_MAX_REDIRECTS=5

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# AGORA — regenerate these at console.agora.io (current values are exposed!)
# -----------------------------------------------------------------------------



# Appointment service (must be running for /api/v1/appointments)
#APPOINTMENT_SERVICE_URL=http://localhost:3003

# Profile service (Patients, doctor/patient profiles). Default in code: 5000.
# PROFILE_SERVICE_URL=http://localhost:5000

# Medical records (prescriptions, documents). Default in code: 3004.
# MEDICAL_RECORDS_SERVICE_URL=http://localhost:3004

# CORS – comma-separated origins (doctor portal default runs on 5173)
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Auth service (for JWT validation)
#AUTH_SERVICE_URL=http://localhost:3001

# JWT validation: JWKS URL must match auth-service (auth has global prefix 'auth' + version 'v1')
# JWT_JWKS_URI=http://localhost:3001/auth/v1/.well-known/jwks.json
# JWT_ISSUER=doctornow-platform
# JWT_AUDIENCE=doctornow-api

# Optional: Redis (set REDIS_OPTIONAL=false in production)
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Circuit breaker: disabled by default in dev so "Breaker is open" doesn't block when a service is down.
# Set to true in production or when you want to protect against cascading failures.
# CIRCUIT_BREAKER_ENABLED=true

# Dev: skip JWT for /api/v1/appointments and doctor availability (default: true in dev). Set false for full auth with doctor portal.
# When true: also skips JWT for GET/PATCH /profiles/doctors/:id/availability; and GET /profiles/patients/me accepts Bearer token by decoding (no JWKS verify) so patient profile works when auth-service/JWKS is unreachable.
# When false: doctor/patient must log in via POST /api/v1/auth/login; all protected routes require valid JWT (JWKS from auth-service).
# SKIP_APPOINTMENT_AUTH=false

# Agora RTC token generation (GET /api/v1/agora/token?channel=...)
# Get these from https://console.agora.io → your project → App ID + Primary Certificate
AGORA_APP_ID=dead09db284f4a87899184c886f34f08
AGORA_APP_CERTIFICATE=ea630d65a0944ce895b83921191333a5
RABBITMQ_URL=amqp://guest:guest@doctor-rabbitmq:5672
MONGODB_URI=mongodb+srv://vinayaksisgain_db_user:iv4jDszFywW0NhhE@cluster0.4fa9t8z.mongodb.net/
# Existing notification exchanges
RABBITMQ_RETRY_DELAY_MS=15000
# -----------------------------------------------------------------------------
# AUDIT LOGGING
# -----------------------------------------------------------------------------
